{
  "name": "@mvh-co/asyncapi-rust-template",
  "version": "1.0.0",
  "description": "Generic AsyncAPI template for generating a Rust WebSocket client",
  "scripts": {
    "postinstall": "node ./scripts/patch-modelina-esm.js",
    "test": "node --test",
    "test:demo": "npm install --prefix ./templates && npm install --prefix ./templates/template && rm -rf /tmp/out && npx @asyncapi/cli generate fromTemplate ./test/demo.yaml ./templates -o /tmp/out -p server=production && cargo check --manifest-path /tmp/out/Cargo.toml"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.2",
    "@asyncapi/generator": "3.4.0",
    "tslib": "2.7.0"
  },
  "overrides": {
    "@asyncapi/parser": "^3.6.3",
    "@babel/core": "^7.29.1",
    "@npmcli/arborist": "^9.9.1",
    "@npmcli/metavuln-calculator": "^9.0.3",
    "@npmcli/run-script": "^10.0.4",
    "ajv": "^8.20.0",
    "cacache": "^19.0.0",
    "jsonpath-plus": "^10.4.0",
    "next": "^15.5.24",
    "pacote": "^21.5.1",
    "postcss": "^8.5.28",
    "tar": "^7.5.22",
    "tslib": "2.7.0"
  },
  "generator": {
    "apiVersion": "v3",
    "parameters": {
      "server": {
        "description": "The server entry to use when constructing the generated example URL.",
        "default": "production",
        "required": false
      }
    },
    "filters": {
      "mapType": "helpers.js",
      "toPascalCase": "helpers.js",
      "toSnakeCase": "helpers.js",
      "toSlug": "helpers.js",
      "getNameFromRef": "helpers.js",
      "generateDoc": "helpers.js",
      "resolveSchema": "helpers.js",
      "resolveMessagePayload": "helpers.js",
      "isRequired": "helpers.js",
      "isConst": "helpers.js",
      "isCommand": "helpers.js",
      "isEvent": "helpers.js",
      "isSend": "helpers.js",
      "isReceive": "helpers.js",
      "getAllSchemas": "helpers.js",
      "getAllChannels": "helpers.js",
      "getAllOperations": "helpers.js",
      "getChannelMessages": "helpers.js",
      "getChannelOperations": "helpers.js",
      "getOperationMessages": "helpers.js",
      "getAllMessages": "helpers.js"
    },
    "supportedProtocols": [
      "ws",
      "wss"
    ]
  }
}
