{
  "name": "@mvh-co/asyncapi-rust-template",
  "version": "1.0.0",
  "description": "Generic AsyncAPI template for generating a Rust WebSocket client",
  "generator": {
    "filters": {
      "mapType": "helpers.js",
      "toPascalCase": "helpers.js",
      "toSnakeCase": "helpers.js",
      "toSlug": "helpers.js",
      "getNameFromRef": "helpers.js",
      "generateDoc": "helpers.js",
      "isCommand": "helpers.js",
      "isEvent": "helpers.js",
      "isSend": "helpers.js",
      "isReceive": "helpers.js",
      "getAllSchemas": "helpers.js",
      "getAllChannels": "helpers.js",
      "getAllOperations": "helpers.js",
      "getChannelMessages": "helpers.js",
      "getChannelOperations": "helpers.js",
      "getOperationMessages": "helpers.js"
    },
    "supportedProtocols": [
      "ws",
      "wss"
    ]
  }
}
